# Vacío utiliza /api bajo el mismo dominio mediante el proxy de Next.
NEXT_PUBLIC_BACK_HOST=
# Servidor privado del backend. En producción usa 172.19.0.1:3201 por defecto.
# BACKEND_INTERNAL_URL=http://127.0.0.1:4000

# Servicios de ubicación intercambiables, sin claves para desarrollo con tráfico moderado.
NEXT_PUBLIC_GEOCODING_URL=https://photon.komoot.io
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
